{
  "name": "capcut-mcp-server",
  "version": "1.0.1",
  "description": "MCP server for CapCut Pro video editing API",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mcp_config.example.json"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "bin": {
    "capcut-mcp-server": "./dist/index.js"
  },
  "keywords": [
    "mcp",
    "capcut",
    "video-editing",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "shx": "^0.3.4",
    "typescript": "^5.7.2"
  }
}
